{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended", "prettier"],
  "env": {
    "browser": true,
    "es2020": true,
    "node": true,
    "mocha": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "webpack.config.js",
    "src/app.ts",
    "src/services/Library.ts",
